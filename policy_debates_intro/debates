  <script>
    (function () {
      const rows = document.querySelectorAll('[data-pdq-row]');

      function closeRow(row) {
        const trigger = row.querySelector('[data-pdq-trigger]');
        const output = row.querySelector('[data-pdq-output]');
        const pill = row.querySelector('[data-pdq-pill]');
        if (!trigger || !output) return;

        trigger.setAttribute('aria-expanded', 'false');
        output.classList.remove('pdq-open');
        output.setAttribute('aria-hidden', 'true');

        if (pill) {
          pill.classList.remove('active');
          pill.textContent = 'Show output';
        }
      }

      function openRow(row) {
        const trigger = row.querySelector('[data-pdq-trigger]');
        const output = row.querySelector('[data-pdq-output]');
        const pill = row.querySelector('[data-pdq-pill]');
        if (!trigger || !output) return;

        // Close all other rows so only one is open at a time
        rows.forEach(r => { if (r !== row) closeRow(r); });

        trigger.setAttribute('aria-expanded', 'true');
        output.classList.add('pdq-open');
        output.setAttribute('aria-hidden', 'false');

        if (pill) {
          pill.classList.add('active');
          pill.textContent = 'Output shown';
        }
      }

      function toggleRow(row) {
        const output = row.querySelector('[data-pdq-output]');
        if (!output) return;
        if (output.classList.contains('pdq-open')) closeRow(row);
        else openRow(row);
      }

      rows.forEach(row => {
        const trigger = row.querySelector('[data-pdq-trigger]');
        const closeBtn = row.querySelector('[data-pdq-close]');

        if (trigger) {
          trigger.addEventListener('click', () => toggleRow(row));
          trigger.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              toggleRow(row);
            }
          });
        }

        if (closeBtn) {
          closeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closeRow(row);
          });
        }

        // Start closed
        closeRow(row);
      });
    })();
  </script>
